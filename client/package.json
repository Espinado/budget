{
  "name": "family-money",
  "private": true,
  "version": "0.1.0",
  "description": "Локальный бюджет для одного человека. База на устройстве, без сети.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "vite build && electron electron/main.cjs",
    "android": "vite build && cap sync android",
    "exe": "vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "build": {
    "appId": "lv.arguss.familymoney",
    "productName": "Family Money",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Family Money",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
